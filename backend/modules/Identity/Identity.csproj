<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\Knight.Domain\Knight.Domain.csproj" />
    <ProjectReference Include="..\..\src\Knight.Application\Knight.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets Knight.UnitTests exercise internal security-sensitive helpers
         (e.g. DelegationGuard) directly rather than only through the public
         application services. -->
    <InternalsVisibleTo Include="Knight.UnitTests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
