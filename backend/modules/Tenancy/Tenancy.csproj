<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\Knight.Domain\Knight.Domain.csproj" />
    <ProjectReference Include="..\..\src\Knight.Application\Knight.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets Knight.IntegrationTests construct internal domain types directly
         (e.g. TenantDomain) to prove database-level constraints hold even when
         an aggregate's own in-memory invariants are deliberately bypassed. -->
    <InternalsVisibleTo Include="Knight.IntegrationTests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
