    <ProjectReference Include="..\..\modules\AccessControl\AccessControl.csproj" />
    <ProjectReference Include="..\..\modules\Customers\Customers.csproj" />
    <ProjectReference Include="..\..\modules\Stores\Stores.csproj" />
    <ProjectReference Include="..\..\modules\Ingestion\Ingestion.csproj" />
    <ProjectReference Include="..\..\modules\FeatureRegistry\FeatureRegistry.csproj" />
    <ProjectReference Include="..\..\modules\Plans\Plans.csproj" />
    <ProjectReference Include="..\..\modules\Subscriptions\Subscriptions.csproj" />
    <ProjectReference Include="..\..\modules\Billing\Billing.csproj" />
    <ProjectReference Include="..\..\modules\Identity\Identity.csproj" />
    <ProjectReference Include="..\..\modules\Tenancy\Tenancy.csproj" />
    <ProjectReference Include="..\..\modules\FeatureManagement\FeatureManagement.csproj" />
    <ProjectReference Include="..\..\modules\Catalog\Catalog.csproj" />
    <ProjectReference Include="..\..\modules\Ordering\Ordering.csproj" />
    <ProjectReference Include="..\..\modules\Customer\Customer.csproj" />
    <ProjectReference Include="..\..\modules\Fulfillment\Fulfillment.csproj" />
    <ProjectReference Include="..\..\modules\Delivery\Delivery.csproj" />
    <ProjectReference Include="..\..\modules\Checkout\Checkout.csproj" />
    <ProjectReference Include="..\..\modules\Payment\Payment.csproj" />
    <ProjectReference Include="..\..\modules\Promotions\Promotions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shipped inside the assembly so a deployment always has a catalogue to
         start from; Catalogue:SeedPath overrides it with a file on disk. -->
    <EmbeddedResource Include="ControlPlane\Seed\commercial-catalogue.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The egress policy and the replay guard are internal because nothing in
         the application layer may construct them, and release-blocking because
         of what they prevent. The tests reach them directly rather than through
         a public shim that would exist only for testing. -->
    <InternalsVisibleTo Include="Knight.UnitTests" />
    <InternalsVisibleTo Include="Knight.IntegrationTests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
