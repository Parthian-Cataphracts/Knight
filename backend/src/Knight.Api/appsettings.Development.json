{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Platform": "Host=localhost;Port=5433;Database=knight;Username=knight;Password=knight",
    "ControlPlane": "Host=localhost;Port=5433;Database=knight;Username=knight;Password=knight",
    "Redis": ""
  },
  "Jwt": {
    "SigningKey": "development-only-signing-key-change-me-please-32chars+"
  },
  "Stores": {
    "$comment": [
      "Local development runs the reference store on 127.0.0.1:8000 over plain",
      "HTTP, so the poller is told where that domain really is and is allowed to",
      "reach a private address. Both are refused by default and must stay that",
      "way anywhere else (docs/security-threat-model.md, SSRF)."
    ],
    "Probe": {
      "Scheme": "http",
      "AllowPrivateNetworks": true,
      "PollIntervalSeconds": 30,
      "BaseUrlOverrides": {
        "reference-store.knight.test": "http://127.0.0.1:8000"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:3000"
    ]
  }
}
