{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ControlPlane": "",
    "Redis": ""
  },
  "Jwt": {
    "Issuer": "platform-api",
    "Audience": "platform-clients",
    "SigningKey": "",
    "PlatformAccessTokenLifetimeMinutes": 5,
    "TenantAccessTokenLifetimeMinutes": 10
  },
  "RefreshToken": {
    "PlatformFamilyLifetime": "12:00:00",
    "TenantFamilyLifetime": "30.00:00:00"
  },
  "Lockout": {
    "FailedAttemptThreshold": 5,
    "LockoutDuration": "00:15:00"
  },
  "PasswordPolicy": {
    "MinLength": 10,
    "MaxLength": 128
  },
  "ControlPlaneAccess": {
    "LockoutThreshold": 5,
    "LockoutDuration": "00:15:00",
    "SessionLifetime": "12:00:00",
    "MfaIssuer": "KNIGHT"
  },
  "Stores": {
    "RotationGracePeriod": "1.00:00:00"
  },
  "Subscriptions": {
    "BillingPeriod": "30.00:00:00"
  },
  "Billing": {
    "PaymentTerms": "14.00:00:00"
  },
  "Catalogue": {
    "SeedPath": ""
  },
  "RateLimiting": {
    "ControlPlanePermitLimit": 200,
    "ControlPlaneLoginPermitLimit": 10,
    "PlatformLoginPermitLimit": 10,
    "TenantLoginPermitLimit": 10,
    "RefreshPermitLimit": 30,
    "WindowSeconds": 60
  },
  "Storage": {
    "LocalRootPath": "storage-data"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Telemetry": {
    "Enabled": false,
    "ServiceName": "knight-control-plane",
    "SampleRatio": 1.0,
    "TraceDatabase": true
  },
  "Retention": {
    "Enabled": true,
    "Interval": "06:00:00",
    "BatchSize": 50000,
    "ErrorEvents": "30.00:00:00",
    "ResolvedErrorGroups": "365.00:00:00",
    "StoreLogs": "14.00:00:00",
    "StoreEvents": "90.00:00:00",
    "StoreHealthChecks": "30.00:00:00",
    "JobHistory": "365.00:00:00",
    "NotificationDeliveries": "90.00:00:00",
    "ResolvedAlerts": "90.00:00:00"
  },
  "Observability": {
    "MaxSamplesPerGroup": 20,
    "EvaluationInterval": "00:01:00",
    "SpikeWindow": "00:15:00",
    "SpikeMinimumCount": 20,
    "SpikeMultiplier": 5,
    "InstallationGrace": "02:00:00",
    "StuckJobThreshold": "00:30:00",
    "DispatchInterval": "00:00:20",
    "MaxDeliveryAttempts": 5,
    "ChannelFailureThreshold": 10,
    "NotificationCooldown": "00:30:00",
    "OpenIncidentsAutomatically": true
  }
}
