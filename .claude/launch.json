{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "knight-api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "src/Knight.Api",
        "--launch-profile",
        "http"
      ],
      "cwd": "backend",
      "port": 5008
    },
    {
      "name": "knight-dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "frontend/knight-dashboard",
      "port": 5173
    },
    {
      "name": "knight-dashboard-verify",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "3000",
        "--strictPort"
      ],
      "cwd": "frontend/knight-dashboard",
      "port": 3000
    }
  ]
}
