# Managed by Ansible (infrastructure/iac). Secrets come from the vault, not here.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:{{ knight_app_port }}

CONTROL_PLANE_DB_CONNECTION_STRING=Host={{ knight_db_host }};Port={{ knight_db_port }};Database={{ knight_db_name }};Username={{ knight_db_user }};Password={{ knight_db_password }}
{% if knight_redis_enabled %}
ConnectionStrings__Redis=localhost:6379
{% endif %}

Jwt__SigningKey={{ knight_jwt_signing_key }}
Jwt__Issuer=knight
Jwt__Audience=knight-clients

# The dashboard is served from the same origin behind nginx, so these stay
# relative — the same single-hostname topology install.sh sets up.
Cors__AllowedOrigins__0=https://{{ knight_domain }}
