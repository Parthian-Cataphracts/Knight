# Copy to .env in this directory and adjust values for local development.
# Never commit a real .env file.

# These must match ConnectionStrings in backend/src/Knight.Api/appsettings.Development.json.
POSTGRES_DB=knight
POSTGRES_USER=knight
POSTGRES_PASSWORD=knight

# Deliberately not 5432. A machine with its own PostgreSQL already on the
# default port would otherwise appear to start fine and then fail
# authentication, because the connection reaches the other server.
POSTGRES_PORT=5433

REDIS_PORT=6379
