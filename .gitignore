bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates
[Dd]ebug/
[Rr]elease/
artifacts/
TestResults/
*.trx
*.coverage
*.coveragexml

# Node (future frontend projects)
node_modules/
dist/
.next/
out/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment / secrets
*.env
.env.*
!.env.example
appsettings.*.local.json
secrets.json

# IDE
.vs/
.vscode/
.idea/
*.DotSettings.user

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
# Anchored to the repository root on purpose: a bare "logs/" also matches source
# directories called logs — it silently swallowed the dashboard's logs screen —
# and a runtime log directory only ever appears at the root anyway.
/logs/
*.log

# Local infrastructure data
infrastructure/docker/volumes/
storage-data/

# Misc
*.tmp
*.temp
.cache/

# Local spec drafts and prompt notes — not part of the product
/first doc.txt
/updated doc.txt

# Frontend
node_modules/
dist/
.env
.env.local

# Built feature artifacts and the local package store. Delivered code is built,
# signed and published — never committed. The rule applies wherever a store
# keeps its own registry, not only at the repository root: a checked-in
# installed.json would tell a fresh clone that features are present which are
# not, and the store reporting its true state is what makes drift detectable.
/dist/
/artifacts/
/knight-features/
stores/knight-features/

# Python build and cache output.
__pycache__/

# setuptools leaves a copy of the sources here when a Feature is built or
# pip-installed from a directory. Generated, and committing it means two copies
# of every Feature module in the tree with nothing keeping them in step.
build/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/

# Database dumps. The default output directory of infrastructure/scripts/knight-backup.sh.
# A control-plane dump holds every customer, credential hash and audit trail there is.
/backups/
backups/
*.dump
