# Copy to .env and fill in. Never commit a filled-in copy: KNIGHT_CLIENT_SECRET
# is a credential that can authenticate as this store.
#
# The secret is shown exactly once, when the credential is issued in the KNIGHT
# dashboard. If it is lost, rotate the credential rather than looking for it.

KNIGHT_BASE_URL=http://localhost:5008
KNIGHT_CLIENT_ID=
KNIGHT_CLIENT_SECRET=
KNIGHT_ENVIRONMENT=Development
KNIGHT_STORE_ID=
STORE_VERSION=1.0.0

KNIGHT_ERROR_REPORTING=true
KNIGHT_LOG_SHIPPING=false
KNIGHT_FEATURE_REFRESH_SECONDS=300
KNIGHT_TIMEOUT_SECONDS=5

# Published at /.well-known/knight-domain-verification so KNIGHT can prove this
# domain belongs to this store. Handed out by the handshake and by the dashboard.
KNIGHT_DOMAIN_VERIFICATION_TOKEN=

# The store's own database. Its own, not KNIGHT's: nothing here ever points at
# the control plane's database.
STORE_DB_NAME=refstore
STORE_DB_USER=knight
STORE_DB_PASSWORD=knight
STORE_DB_HOST=127.0.0.1
STORE_DB_PORT=5433

# Optional. With no Redis the store uses an in-process cache, which is correct
# for one worker process and not for several.
KNIGHT_REDIS_URL=

DJANGO_SECRET_KEY=development-only-store-secret-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
