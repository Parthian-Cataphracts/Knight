<Project Sdk="Microsoft.NET.Sdk">

  <!--
    net10.0 while the library is net8.0, on purpose.

    The library targets the lower of the two frameworks its consumer stores are
    on, so both can reference it. The tests only have to run somewhere, and
    running them on the newest runtime also proves the assembly loads on it —
    which is the combination a net10 store will actually be in.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Knight.StoreAgent\Knight.StoreAgent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
